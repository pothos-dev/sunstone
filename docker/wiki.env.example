# Sunstone Web — git-synced wiki. Copy to ./wiki.env and fill in.
#
# An EMPTY value means UNSET, uniformly. Leaving SUNSTONE_GIT_ORIGIN empty does
# not error — it silently downgrades this deployment to git-local (commits stay
# in the container and never reach origin). Check GET /api/sync-status after
# bringing the stack up.
#
# This file holds three secrets. Do not commit your filled-in copy.

# --- SSR web server behind a reverse proxy (ticket 01) ---
ORIGIN=https://wiki.example.internal
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# --- Login: generic OIDC pointed at Google (ticket 01) ---
# Register the callback https://<your-host>/auth/callback/oidc — the provider id
# is hardcoded `oidc`. Scope sign-in to your org with an Internal OAuth client:
# the app treats AUTHENTICATED AS AUTHORIZED, so anyone who can log in can write.
SUNSTONE_OIDC_ISSUER=https://accounts.google.com
SUNSTONE_OIDC_CLIENT_ID=REPLACE-ME.apps.googleusercontent.com
SUNSTONE_OIDC_CLIENT_SECRET=REPLACE-ME
SUNSTONE_OIDC_NAME=Google

# --- Secrets: openssl rand -hex 32 (ticket 01) ---
AUTH_SECRET=REPLACE-ME
# Unset ⇒ read-only: writes 401 AND history is unavailable (ticket 17).
SUNSTONE_JWT_SECRET=REPLACE-ME

# --- git-synced shape (ticket 12) ---
# Required whenever any SUNSTONE_GIT_* var is set. No default.
SUNSTONE_GIT_BRANCH=main
# URL form (ssh://user@host/absolute/path), so the path is absolute rather than
# relative to the remote user's home (ticket 11).
SUNSTONE_GIT_ORIGIN=ssh://git@host.docker.internal/opt/docker/git-wiki/aitools-wiki.git
# Bundle root relative to /srv/repo. Empty = repo root. Absolute or `..` ⇒ boot error.
SUNSTONE_GIT_BUNDLE_SUBDIR=
# Inbound poll period. Saves kick the loop, so this governs INBOUND only.
SUNSTONE_GIT_SYNC_INTERVAL_SECS=10
# base64 of the deploy key's private PEM, single line:
#   base64 -w0 < ~/.ssh/sunstone_wiki_deploy
SUNSTONE_GIT_SSH_KEY=REPLACE-ME
# ssh-keyscan output. Set ⇒ strict host-key checking. Unset ⇒ accept-new,
# never persisted (re-trusted on first connect after every recreate).
SUNSTONE_GIT_KNOWN_HOSTS=REPLACE-ME
# Committer identity for the loop. Override to match a forge bot account.
# SUNSTONE_GIT_SYNC_NAME=Sunstone Sync
# SUNSTONE_GIT_SYNC_EMAIL=sync@sunstone.invalid

# Do NOT set SUNSTONE_BUNDLE here — it is ignored (and logged) in a git shape.
# Do NOT set SUNSTONE_BUNDLE_SEED_FROM here — with an origin it is a boot error.
