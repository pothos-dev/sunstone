{
  "name": "sunstone",
  "version": "0.19.3",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "bun test src/lib",
    "build:wasm": "wasm-pack build crates/sunstone-wasm --target web --out-dir ../../src/lib/wasm/pkg",
    "build:types": "echo '[build:types] Step 0 no-op: the ~5 wasm DTO .d.ts are emitted by tsify via build:wasm (ADR 0006 §6); the ts-rs IPC-DTO export half has no DTOs yet and its cargo-test export wiring lands with the DTO family. Placeholder until then.'",
    "build:frontend": "bun run build:wasm && bun run build:types",
    "check:ci": "bun run build:frontend && bun run check",
    "test:unit:ci": "bun run build:frontend && bun run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:ci": "bun run build:frontend && playwright test",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@atomic-editor/editor": "0.4.3",
    "@auth/sveltekit": "^1.11.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@fontsource-variable/jost": "^5.3.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "mermaid": "^11.15.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.3",
    "bun-types": "^1.3.14",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "patchedDependencies": {
    "@atomic-editor/editor@0.4.3": "patches/@atomic-editor%2Feditor@0.4.3.patch"
  }
}
