.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example

# Filled-in env_file for docker-compose.wiki.yml — holds AUTH_SECRET, the OIDC
# client secret and the base64 deploy key. Only wiki.env.example is committed.
wiki.env
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Generated wasm-pack output (built by `build:wasm`, ADR 0006 §1)
/src/lib/wasm/pkg

# Rust / Tauri build artifacts
/target
/src-tauri/target
/src-tauri/gen

# Playwright artifacts
/test-results
/playwright-report
/.playwright
# Test screenshots are regenerated on every run; keep the dir, ignore the images
/tests/screenshots/*.png

# Local-only example OKF bundle (Google ga4 sample); not shipped in the repo
/examples


# Local editor workspace file (machine-specific)
/.workspace

# Wayfinder planning scratch (local-only; the plan's deliverable is the ADR)
/.scratch

# Registered git worktrees live here (`git worktree list`). They are separate
# checkouts of this same repo, so they must never be committable by it — an
# `add -A` would otherwise pull in whatever old state they hold.
/.claude/worktrees
